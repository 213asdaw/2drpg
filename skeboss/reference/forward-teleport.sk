# ============================================================
# 우클릭 전방 텔레포트
# plugins/Skript/scripts/forward-teleport.sk
#
# - 우클릭: 시선 방향 앞 10칸 이내 플레이어 쪽으로 텔포
# - 탐색: 시선 축에서 상·하·좌·우 각 1블록 (반경 1, 넓히지 않음)
# - 경로에 몸이 안 들어가는 블록 있으면 그 직전에서 멈춤
# ============================================================

options:
	teleport-range: 10
	tunnel-half-width: 1
	cooldown-seconds: 2
	require-sneak: false

function tpCooldownKey(p: player) :: text:
	return "fwdtp::%uuid of {_p}%"

function canUseForwardTeleport(p: player) :: boolean:
	if {@require-sneak} is true:
		if {_p} is not sneaking:
			return false
	set {_key} to tpCooldownKey({_p})
	if {%{_key}%} is set:
		if difference between {%{_key}%} and now < {@cooldown-seconds} seconds:
			return false
	return true

function markForwardTeleportUsed(p: player):
	set {_key} to tpCooldownKey({_p})
	set {%{_key}%} to now

function isPassableBlock(b: block) :: boolean:
	if {_b} is air:
		return true
	if {_b} is water:
		return true
	if {_b} is cave air:
		return true
	if {_b} is void air:
		return true
	if {_b} is tall grass:
		return true
	if {_b} is short grass:
		return true
	if block data of {_b} is solid:
		return false
	return true

function isStandableAt(loc: location) :: boolean:
	set {_feet} to block at {_loc}
	set {_head} to block at {_loc} ~ vector(0, 1, 0)
	if isPassableBlock({_feet}) is false:
		return false
	if isPassableBlock({_head}) is false:
		return false
	return true

# 시선 축 1~range 칸, 각 지점에서 거리 halfWidth 이내(=1블록 폭)
function isInForwardTunnel(caster: player, target: entity, range: number, halfWidth: number) :: boolean:
	if world of {_caster} is not world of {_target}:
		return false
	set {_limit} to {_halfWidth} + 0.35
	loop {_range} times:
		set {_probe} to location (loop-number) blocks in front of {_caster}
		set {_dist} to distance between {_probe} and {_target}
		if {_dist} <= {_limit}:
			return true
	return false

function findForwardTunnelTarget(caster: player, range: number, halfWidth: number) :: player:
	set {_best} to null
	set {_bestDist} to 9999
	loop all players:
		if loop-player is {_caster}:
			continue
		if world of loop-player is not world of {_caster}:
			continue
		if isInForwardTunnel({_caster}, loop-player, {_range}, {_halfWidth}) is false:
			continue
		set {_d} to distance between {_caster} and loop-player
		if {_d} > {_range} + 0.5:
			continue
		if {_best} is not set:
			set {_best} to loop-player
			set {_bestDist} to {_d}
		else if {_d} < {_bestDist}:
			set {_best} to loop-player
			set {_bestDist} to {_d}
	return {_best}

function resolveTeleportStop(caster: player, goal: location, maxRange: number) :: location:
	set {_from} to location of {_caster}
	set {_fx} to x-coordinate of {_from}
	set {_fy} to y-coordinate of {_from}
	set {_fz} to z-coordinate of {_from}
	set {_gx} to x-coordinate of {_goal}
	set {_gy} to y-coordinate of {_goal}
	set {_gz} to z-coordinate of {_goal}
	set {_dx} to {_gx} - {_fx}
	set {_dy} to {_gy} - {_fy}
	set {_dz} to {_gz} - {_fz}
	set {_lenSq} to ({_dx} * {_dx}) + ({_dy} * {_dy}) + ({_dz} * {_dz})
	if {_lenSq} < 0.0001:
		return {_from}
	set {_len} to sqrt({_lenSq})
	if {_len} > {_maxRange}:
		set {_scale} to {_maxRange} / {_len}
		set {_dx} to {_dx} * {_scale}
		set {_dy} to {_dy} * {_scale}
		set {_dz} to {_dz} * {_scale}
		set {_len} to {_maxRange}
	set {_last} to {_from}
	set {_step} to 0
	set {_steps} to rounded up {_len} * 4
	loop {_steps} times:
		add 0.25 to {_step}
		if {_step} > {_len}:
			stop loop
		set {_ratio} to {_step} / {_len}
		set {_check} to {_from}
		set x-coordinate of {_check} to {_fx} + ({_dx} * {_ratio})
		set y-coordinate of {_check} to {_fy} + ({_dy} * {_ratio})
		set z-coordinate of {_check} to {_fz} + ({_dz} * {_ratio})
		if isStandableAt({_check}) is false:
			return {_last}
		set {_last} to {_check}
	return {_last}

on right click:
	if canUseForwardTeleport(player) is false:
		stop

	set {_target} to findForwardTunnelTarget(player, {@teleport-range}, {@tunnel-half-width})
	if {_target} is not set:
		send action bar "&7앞 &f{@teleport-range}&7칸·폭 &f1&7블록 안에 대상이 없습니다." to player
		stop

	set {_goal} to location of {_target}
	set {_land} to resolveTeleportStop(player, {_goal}, {@teleport-range})
	if distance between player and {_land} < 0.4:
		send action bar "&7막혀서 더 갈 수 없습니다." to player
		stop

	teleport player to {_land}
	play sound "entity.enderman.teleport" with volume 0.8 and pitch 1.2 at player
	markForwardTeleportUsed(player)
	send action bar "&b전방 텔레포 &7→ &f%name of {_target}%" to player
