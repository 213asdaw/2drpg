# SkeBoss RPG 스탯 — skeboss.sk 와 동일 (reference 복사본)

options:
	boss-name: 인조인간
	bdef: 240
	batk: 80
	bexp: 500
	bmelee: 10

function initSkeBossStats(boss: entity):
	set {_u} to uuid of {_boss}
	set {방어력::%{_u}%} to {@bdef}
	set {공격력::%{_u}%} to {@batk}
	set {방어력::%{_boss}%} to {@bdef}
	set {공격력::%{_boss}%} to {@batk}
	set {boss.init::%{_u}%} to true

function clearSkeBossStats(boss: entity):
	set {_u} to uuid of {_boss}
	delete {방어력::%{_boss}%}
	delete {공격력::%{_boss}%}
	delete {방어력::%{_u}%}
	delete {공격력::%{_u}%}
	delete {boss.init::%{_u}%}

function getDefense(e: entity) :: number:
	if {방어력::%{_e}%} is set:
		return {방어력::%{_e}%}
	set {_u} to uuid of {_e}
	if {방어력::%{_u}%} is set:
		return {방어력::%{_u}%}
	return 0

function getAttack(e: entity) :: number:
	if {공격력::%{_e}%} is set:
		return {공격력::%{_e}%}
	set {_u} to uuid of {_e}
	if {공격력::%{_u}%} is set:
		return {공격력::%{_u}%}
	return 0

on spawn of zombie:
	wait 5 ticks
	if uncolored name of event-entity does not contain "{@boss-name}":
		stop
	set {_u} to uuid of event-entity
	if {boss.init::%{_u}%} is not set:
		initSkeBossStats(event-entity)

every 15 seconds:
	loop all zombies:
		if uncolored name of loop-zombie does not contain "{@boss-name}":
			continue
		set {_u} to uuid of loop-zombie
		if {boss.init::%{_u}%} is not set:
			initSkeBossStats(loop-zombie)

on damage:
	set {_pl} to null
	if attacker is a player:
		set {_pl} to attacker
	else if damager is a player:
		set {_pl} to damager
	else if attacker is set:
		if shooter of attacker is a player:
			set {_pl} to shooter of attacker
	else if damager is set:
		if shooter of damager is a player:
			set {_pl} to shooter of damager

	set {_victimBoss} to false
	if victim is a zombie:
		if uncolored name of victim contains "{@boss-name}":
			set {_victimBoss} to true

	set {_atkBoss} to false
	if attacker is a zombie:
		if uncolored name of attacker contains "{@boss-name}":
			set {_atkBoss} to true

	if {_pl} is not set:
		if {_atkBoss} is false:
			stop

	if {_atkBoss} is true:
		set {_key} to attacker
	else:
		set {_key} to {_pl}

	set {공격::%{_key}%} to damage
	set {_stat} to getAttack({_key})
	if {_atkBoss} is true:
		if damage <= {@bmelee}:
			if {_stat} > 0:
				add {_stat} to {공격::%{_key}%}
	else:
		if {_stat} > 0:
			add {_stat} to {공격::%{_key}%}

	if victim is set:
		set {막는량::%victim%} to 0
		set {_def} to getDefense(victim)
		if {_def} > 0:
			set {막는량::%victim%} to {_def} / 4
		if {막는량::%victim%} > 90:
			set {막는량::%victim%} to 90
		remove {공격::%{_key}%} * {막는량::%victim%} / 100 from {공격::%{_key}%}

	if {_victimBoss} is true:
		set damage to {공격::%{_key}%}
	else if {_atkBoss} is true:
		set damage to {공격::%{_key}%}
	else if {_pl} is set:
		if scoreboard tags of {_pl} does not contain "using_skill":
			set damage to {공격::%{_key}%}

on death of zombie:
	if uncolored name of victim does not contain "{@boss-name}":
		stop
	clearSkeBossStats(victim)
	wait 1 tick
	set {_loc} to location of victim
	drop 3 diamond named "&b인조인간 파편" at {_loc}
	drop 1 netherite scrap at {_loc}
	chance of 25%:
		drop 1 emerald block at {_loc}
	if attacker is a player:
		give {@bexp} xp to attacker
	else:
		drop {@bexp} experience at {_loc}
