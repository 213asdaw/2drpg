# ============================================================
# SkeBoss (인조인간) — RPG 스탯 + 드랍 Skript
#
# ※ options 이름은 영문만 사용 ({@boss-공격력} 은 Skript 오류)
# ※ 함수 안에서는 {_boss} 처럼 중괄호 필수
# ============================================================

options:
	boss-name: 인조인간
	bdef: 240
	batk: 80
	bexp: 500
	bmelee: 10

function isSkeBoss(e: entity) :: boolean:
	if {_e} is not a zombie:
		return false
	if uncolored name of {_e} contains "{@boss-name}":
		return true
	return false

function initSkeBossStats(boss: entity):
	set {_u} to uuid of {_boss}
	set {방어력::%{_u}%} to {@bdef}
	set {공격력::%{_u}%} to {@batk}
	set {방어력::%{_boss}%} to {@bdef}
	set {공격력::%{_boss}%} to {@batk}
	set {boss.init::%{_u}%} to true

function getDefense(e: entity) :: number:
	if {방어력::%{_e}%} is set:
		return {방어력::%{_e}%}
	if isSkeBoss({_e}):
		set {_u} to uuid of {_e}
		if {방어력::%{_u}%} is set:
			return {방어력::%{_u}%}
	return 0

function getAttack(e: entity) :: number:
	if {공격력::%{_e}%} is set:
		return {공격력::%{_e}%}
	if isSkeBoss({_e}):
		set {_u} to uuid of {_e}
		if {공격력::%{_u}%} is set:
			return {공격력::%{_u}%}
	return 0

function clearSkeBossStats(boss: entity):
	set {_u} to uuid of {_boss}
	delete {방어력::%{_boss}%}
	delete {공격력::%{_boss}%}
	delete {방어력::%{_u}%}
	delete {공격력::%{_u}%}
	delete {boss.init::%{_u}%}

on spawn of zombie:
	wait 5 ticks
	if isSkeBoss(event-entity):
		set {_u} to uuid of event-entity
		if {boss.init::%{_u}%} is not set:
			initSkeBossStats(event-entity)

every 15 seconds:
	loop all zombies:
		if isSkeBoss(loop-zombie):
			set {_u} to uuid of loop-zombie
			if {boss.init::%{_u}%} is not set:
				initSkeBossStats(loop-zombie)

on damage:
	if attacker is not set:
		stop

	if isSkeBoss(attacker):
		set {공격::%attacker%} to damage
		set {_atk} to getAttack(attacker)
		if damage <= {@bmelee} and {_atk} > 0:
			add {_atk} to {공격::%attacker%}
	else:
		set {공격::%attacker%} to damage
		set {_atk} to getAttack(attacker)
		if {_atk} > 0:
			add {_atk} to {공격::%attacker%}

	if victim is set:
		set {막는량::%victim%} to 0
		set {_def} to getDefense(victim)
		if {_def} > 0:
			set {막는량::%victim%} to {_def} / 4
		if {막는량::%victim%} > 90:
			set {막는량::%victim%} to 90
		remove {공격::%attacker%} * {막는량::%victim%} / 100 from {공격::%attacker%}

	if attacker is a player:
		if scoreboard tags of attacker doesn't contain "using_skill":
			set damage to {공격::%attacker%}
	else:
		set damage to {공격::%attacker%}

on death of zombie:
	if isSkeBoss(victim):
		clearSkeBossStats(victim)
		wait 1 tick
		set {_loc} to location of victim
		drop 3 diamond named "&b인조인간 파편" at {_loc}
		drop 1 netherite scrap at {_loc}
		chance of 25%:
			drop 1 emerald block at {_loc}
		set death event's dropped exp to {@bexp}
		if attacker is a player:
			give {@bexp} xp to attacker
