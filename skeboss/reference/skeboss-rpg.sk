# ============================================================
# SkeBoss (인조인간) — RPG 스탯 + 드랍 Skript
# plugins/Skript/scripts/ 에 넣고 /sk reload 하세요.
#
# SkeBoss 플러gin: 레이저 시전 중 보스에 scoreboard tag "using_skill" 부여
# (플레이어 스킬과 동일한 태그 — 빔 데미지는 Skript에서 공격력×배율로 계산)
# ============================================================

options:
	boss-name: 인조인간
	boss-방어력: 240
	boss-공격력: 80
	boss-exp: 500
	boss-beam-multiplier: 2

# ---------- 보스 판별 ----------
function isSkeBoss(e: entity) :: boolean:
	if {_e} is not a zombie:
		return false
	if uncolored name of {_e} contains "{@boss-name}":
		return true
	return false

# ---------- 스탯 등록 ----------
function initSkeBossStats(boss: entity):
	set {방어력::%{_boss}%} to {@boss-방어력}
	set {공격력::%{_boss}%} to {@boss-공격력}
	set {boss.init::%uuid of {_boss}%} to true

function clearSkeBossStats(boss: entity):
	delete {방어력::%{_boss}%}
	delete {공격력::%{_boss}%}
	delete {boss.init::%uuid of {_boss}%}

on spawn of zombie:
	wait 5 ticks
	if isSkeBoss(event-entity):
		if {boss.init::%uuid of event-entity%} is not set:
			initSkeBossStats(event-entity)

every 15 seconds:
	loop all zombies:
		if isSkeBoss(loop-zombie):
			if {boss.init::%uuid of loop-zombie%} is not set:
				initSkeBossStats(loop-zombie)

# ---------- 데미지 (기존 RPG 공식 + 보스 using_skill 빔) ----------
# ※ 기존 on damage 가 있으면 아래 내용으로 교체하거나 병합하세요.
on damage:
	if attacker is not set:
		stop

	# SkeBoss 레이저: 플러gin이 using_skill 태그 부여 → 공격력×배율
	if isSkeBoss(attacker) and scoreboard tags of attacker contains "using_skill":
		if {공격력::%attacker%} is not set:
			stop
		set {공격::%attacker%} to {공격력::%attacker%} * {@boss-beam-multiplier}
	else:
		set {공격::%attacker%} to damage
		if {공격력::%attacker%} is set:
			add {공격력::%attacker%} to {공격::%attacker%}

	if victim is set:
		set {막는량::%victim%} to 0
		if {방어력::%victim%} is set:
			set {막는량::%victim%} to {방어력::%victim%} / 4
		if {막는량::%victim%} > 90:
			set {막는량::%victim%} to 90
		remove {공격::%attacker%} * {막는량::%victim%} / 100 from {공격::%attacker%}

	# 플레이어 using_skill = 스킬 스크립트가 데미지 처리 (기존과 동일)
	# 보스·몹은 항상 계산된 값 적용
	if attacker is a player:
		if scoreboard tags of attacker doesn't contain "using_skill":
			set damage to {공격::%attacker%}
	else:
		set damage to {공격::%attacker%}

# ---------- 사망: 스탯 정리 + 드랍 ----------
on death of zombie:
	if isSkeBoss(victim):
		clearSkeBossStats(victim)
		wait 1 tick
		set {_loc} to location of victim

		drop 3 diamond named "&b인조인간 파편" at {_loc}
		drop 1 netherite scrap at {_loc}
		chance of 25%:
			drop 1 emerald block at {_loc}

		set death event's dropped exp to {@boss-exp}
		if attacker is a player:
			give {@boss-exp} xp to attacker
