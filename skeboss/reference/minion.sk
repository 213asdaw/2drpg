# 롤 스타일 미니언 (구버전 Skript)
# plugins/Skript/scripts/minion.sk
#
# /미니언
# /미니언팀 <blue|red>
# /미니언목표 [blue|red]     - 현재 위치를 해당 팀 미니언 목표지점으로
# /미니언소환 [blue|red] [수]
# /미니언제거                 - 근처 미니언 제거
# /미니언전체제거
# /미니언목록
#
# 우선순위: 적 플레이어 > 적 미니언 > 적 포탑
# 대상 없으면 팀 목표지점으로 이동
# 포탑 팀 변수 {turret.team.player::%uuid%} 와 공유

command /미니언:
	trigger:
		send "&e/미니언팀 <blue|red>" to player
		send "&e/미니언목표 [blue|red]" to player
		send "&e/미니언소환 [blue|red] [수]" to player
		send "&e/미니언제거" to player
		send "&e/미니언전체제거" to player
		send "&e/미니언목록" to player

command /미니언팀 <text>:
	trigger:
		set {_team} to arg-1
		if {_team} is "blue":
			set {turret.team.player::%uuid of player%} to "blue"
			send "&9팀을 &fBLUE&9 로 설정했습니다." to player
			stop
		if {_team} is "red":
			set {turret.team.player::%uuid of player%} to "red"
			send "&c팀을 &fRED&c 로 설정했습니다." to player
			stop
		send "&c사용법: /미니언팀 <blue|red>" to player

command /미니언목표 [<text>]:
	trigger:
		set {_team} to "blue"
		if {turret.team.player::%uuid of player%} is set:
			set {_team} to {turret.team.player::%uuid of player%}
		if arg-1 is set:
			set {_team} to arg-1
		if {_team} is not "blue":
			if {_team} is not "red":
				send "&c사용법: /미니언목표 [blue|red]" to player
				stop
		set {minion.goal::%{_team}%} to location of player
		send "&a%{_team}% 팀 미니언 목표를 현재 위치로 설정했습니다." to player
		if {_team} is "blue":
			draw 8 happy villager at player
		if {_team} is "red":
			draw 8 flame at player

command /미니언목록:
	trigger:
		set {_nb} to 0
		set {_nr} to 0
		loop {minion.list::*}:
			if loop-value is set:
				set {_k} to "%uuid of loop-value%"
				if {minion.team::%{_k}%} is "blue":
					add 1 to {_nb}
				if {minion.team::%{_k}%} is "red":
					add 1 to {_nr}
		set {_my} to "blue"
		if {turret.team.player::%uuid of player%} is set:
			set {_my} to {turret.team.player::%uuid of player%}
		send "&b내 팀: &f%{_my}%" to player
		send "&b미니언 &9블루 %{_nb}%&7 / &c레드 %{_nr}%" to player
		if {minion.goal::blue} is set:
			send "&9블루 목표 설정됨" to player
		else:
			send "&9블루 목표 &c미설정" to player
		if {minion.goal::red} is set:
			send "&c레드 목표 설정됨" to player
		else:
			send "&c레드 목표 &c미설정" to player

command /미니언제거:
	trigger:
		delete {_near}
		set {_best} to 999
		loop {minion.list::*}:
			if loop-value is set:
				set {_d} to distance between player and loop-value
				if {_d} <= 10:
					if {_d} < {_best}:
						set {_near} to loop-value
						set {_best} to {_d}
		if {_near} is not set:
			send "&c근처 10칸 안에 미니언이 없습니다." to player
			stop
		set {_k} to "%uuid of {_near}%"
		remove {_near} from {minion.list::*}
		delete {minion.team::%{_k}%}
		delete {minion.alive::%{_k}%}
		delete {minion.next::%{_k}%}
		kill {_near}
		send "&a근처 미니언을 제거했습니다." to player

command /미니언전체제거:
	trigger:
		set {_n} to 0
		loop {minion.list::*}:
			set {_m} to loop-value
			if {_m} is set:
				set {_k} to "%uuid of {_m}%"
				delete {minion.team::%{_k}%}
				delete {minion.alive::%{_k}%}
				delete {minion.next::%{_k}%}
				kill {_m}
				add 1 to {_n}
		delete {minion.list::*}
		send "&a미니언 %{_n}%마리를 모두 제거했습니다." to player

command /미니언소환 [<text>] [<number>]:
	trigger:
		set {_team} to "blue"
		if {turret.team.player::%uuid of player%} is set:
			set {_team} to {turret.team.player::%uuid of player%}
		set {_amt} to 1
		if arg-1 is set:
			if arg-1 is "blue":
				set {_team} to "blue"
			if arg-1 is "red":
				set {_team} to "red"
			if arg-1 is not "blue":
				if arg-1 is not "red":
					send "&c사용법: /미니언소환 [blue|red] [수]" to player
					stop
		if arg-2 is set:
			set {_amt} to arg-2
			if {_amt} < 1:
				set {_amt} to 1
			if {_amt} > 20:
				set {_amt} to 20
		if {minion.goal::%{_team}%} is not set:
			send "&e경고: %{_team}% 팀 목표가 없습니다. &7/미니언목표 %{_team}%" to player
		set {_i} to 0
		loop {_amt} times:
			add 1 to {_i}
			set {_loc} to location of player
			spawn zombie at {_loc}
			set {_m} to last spawned entity
			if {_m} is set:
				set {_k} to "%uuid of {_m}%"
				set {minion.team::%{_k}%} to {_team}
				set {minion.alive::%{_k}%} to true
				add {_m} to {minion.list::*}
				set max health of {_m} to 40
				set health of {_m} to 40
				if {_team} is "blue":
					set name of {_m} to "&9&l블루 미니언"
					set helmet of {_m} to blue wool
				if {_team} is "red":
					set name of {_m} to "&c&l레드 미니언"
					set helmet of {_m} to red wool
				set chestplate of {_m} to leather chestplate
				clear drops of {_m}
		send "&a%{_team}% 미니언 &f%{_amt}%&a마리를 소환했습니다." to player
		play sound "entity.zombie.ambient" with volume 0.8 and pitch 1.2 at player

# 바닐라 AI 타겟팅 막기 (스크립트가 직접 공격)
on target:
	if entity is set:
		set {_k} to "%uuid of entity%"
		if {minion.alive::%{_k}%} is set:
			cancel event

# 미니언끼리/아군 플레이어 어그로 방지용
on damage:
	if attacker is not set:
		stop
	if victim is not set:
		stop
	set {_ak} to "%uuid of attacker%"
	set {_vk} to "%uuid of victim%"
	# 미니언이 같은 팀 미니언/플레이어 때리면 취소
	if {minion.team::%{_ak}%} is set:
		set {_ateam} to {minion.team::%{_ak}%}
		if {minion.team::%{_vk}%} is set:
			if {minion.team::%{_vk}%} is {_ateam}:
				cancel event
				stop
		if victim is a player:
			set {_vteam} to "blue"
			if {turret.team.player::%uuid of victim%} is set:
				set {_vteam} to {turret.team.player::%uuid of victim%}
			if {_vteam} is {_ateam}:
				cancel event
				stop
	# 플레이어가 아군 미니언 때리면 취소 (원하면 주석)
	if attacker is a player:
		if {minion.team::%{_vk}%} is set:
			set {_mteam} to {minion.team::%{_vk}%}
			set {_ateam} to "blue"
			if {turret.team.player::%uuid of attacker%} is set:
				set {_ateam} to {turret.team.player::%uuid of attacker%}
			if {_ateam} is {_mteam}:
				cancel event
				send action bar "&7아군 미니언은 공격할 수 없습니다." to attacker
				stop

on death:
	if victim is not set:
		stop
	set {_k} to "%uuid of victim%"
	if {minion.alive::%{_k}%} is set:
		remove victim from {minion.list::*}
		delete {minion.team::%{_k}%}
		delete {minion.alive::%{_k}%}
		delete {minion.next::%{_k}%}
		clear drops
		draw 6 cloud at victim

# 낮에 불타는 것 방지 + AI 루프
every 5 ticks:
	loop {minion.list::*}:
		set {_m} to loop-value
		if {_m} is not set:
			remove {_m} from {minion.list::*}
		if {_m} is set:
			set {_k} to "%uuid of {_m}%"
			if {minion.alive::%{_k}%} is not set:
				remove {_m} from {minion.list::*}
			if {minion.alive::%{_k}%} is set:
				extinguish {_m}
				set {_team} to {minion.team::%{_k}%}
				delete {_target}
				set {_best} to 9999

				# 1) 적 플레이어
				loop all players in radius 10 around {_m}:
					set {_e} to loop-player
					set {_eteam} to "blue"
					if {turret.team.player::%uuid of {_e}%} is set:
						set {_eteam} to {turret.team.player::%uuid of {_e}%}
					if {_eteam} is not {_team}:
						set {_hp} to health of {_e}
						if {_hp} is set:
							if {_hp} > 0:
								set {_d} to distance between {_m} and {_e}
								if {_d} < {_best}:
									set {_target} to {_e}
									set {_best} to {_d}

				# 2) 적 미니언
				if {_target} is not set:
					set {_best} to 9999
					loop all zombies in radius 10 around {_m}:
						set {_e} to loop-zombie
						if {_e} is not {_m}:
							set {_ek} to "%uuid of {_e}%"
							if {minion.team::%{_ek}%} is set:
								if {minion.team::%{_ek}%} is not {_team}:
									set {_hp} to health of {_e}
									if {_hp} is set:
										if {_hp} > 0:
											set {_d} to distance between {_m} and {_e}
											if {_d} < {_best}:
												set {_target} to {_e}
												set {_best} to {_d}

				# 3) 적 포탑
				if {_target} is not set:
					set {_best} to 9999
					loop all armor stands in radius 10 around {_m}:
						set {_e} to loop-armor stand
						set {_ek} to "%uuid of {_e}%"
						if {turret.hp::%{_ek}%} is set:
							if {turret.team::%{_ek}%} is not {_team}:
								if {turret.hp::%{_ek}%} > 0:
									set {_d} to distance between {_m} and {_e}
									if {_d} < {_best}:
										set {_target} to {_e}
										set {_best} to {_d}

				# 공격 or 이동
				if {_target} is set:
					set {_d} to distance between {_m} and {_target}
					if {_d} <= 2.2:
						# 공격 쿨
						set {_canHit} to true
						if {minion.next::%{_k}%} is set:
							if difference between {minion.next::%{_k}%} and now < 1 second:
								set {_canHit} to false
						if {_canHit} is true:
							set {_ek} to "%uuid of {_target}%"
							if {turret.hp::%{_ek}%} is set:
								set {_thp} to {turret.hp::%{_ek}%}
								remove 5 from {_thp}
								if {_thp} < 0:
									set {_thp} to 0
								set {turret.hp::%{_ek}%} to {_thp}
								if {_thp} <= 0:
									play sound "entity.generic.explode" with volume 1 and pitch 0.8 at {_target}
									loop 8 times:
										draw 1 flame at {_target}
									remove {_target} from {turret.list::*}
									delete {turret.hp::%{_ek}%}
									delete {turret.maxhp::%{_ek}%}
									delete {turret.team::%{_ek}%}
									delete {turret.owner::%{_ek}%}
									delete {turret.alive::%{_ek}%}
									kill {_target}
							else:
								damage {_target} by 5
							if {_team} is "blue":
								draw 2 happy villager at {_target}
							if {_team} is "red":
								draw 2 flame at {_target}
							play sound "entity.zombie.attack_wooden_door" with volume 0.5 and pitch 1.3 at {_m}
							set {minion.next::%{_k}%} to now
					else:
						# 대상에게 접근
						push {_m} towards {_target} at speed 0.28
				else:
					# 목표지점으로 이동
					if {minion.goal::%{_team}%} is set:
						set {_goal} to {minion.goal::%{_team}%}
						if "%world of {_goal}%" is "%world of {_m}%":
							set {_gd} to distance between {_m} and {_goal}
							if {_gd} > 1.5:
								push {_m} towards {_goal} at speed 0.22
