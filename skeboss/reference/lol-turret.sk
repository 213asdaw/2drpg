# ============================================================
# 롤 스타일 포탑 (구버전 Skript 호환 / 함수 없음)
# plugins/Skript/scripts/포탑.sk
#
# 명령어:
#   /포탑 소환 [blue|red]
#   /포탑 제거
#   /포탑 목록
#   /포탑 팀 <blue|red>
#
# 팀 구분:
#   blue = 파란 이름/양털 헬멧/물방울 레이저
#   red  = 빨간 이름/빨간 양털 헬멧/불꽃 레이저
#   같은 팀 플레이어·포탑은 공격 안 함 / 아군 포탑 피격 무시
# ============================================================

command /포탑 [<text>] [<text>]:
	trigger:
		set {_sub} to arg-1
		if {_sub} is not set:
			send "&e/포탑 소환 [blue|red]" to player
			send "&e/포탑 제거" to player
			send "&e/포탑 목록" to player
			send "&e/포탑 팀 <blue|red>" to player
			stop

		if {_sub} is "팀":
			if arg-2 is not set:
				send "&c사용법: /포탑 팀 <blue|red>" to player
				stop
			set {_team} to arg-2
			if {_team} is "blue":
				set {turret.team.player::%uuid of player%} to "blue"
				send "&9팀을 &fBLUE&9 로 설정했습니다." to player
				stop
			if {_team} is "red":
				set {turret.team.player::%uuid of player%} to "red"
				send "&c팀을 &fRED&c 로 설정했습니다." to player
				stop
			send "&c팀은 blue 또는 red 만 가능합니다." to player
			stop

		if {_sub} is "목록":
			set {_n} to 0
			set {_nb} to 0
			set {_nr} to 0
			set {_u} to "%uuid of player%"
			loop {turret.list::*}:
				set {_k} to "%uuid of loop-value%"
				if {turret.owner::%{_k}%} is {_u}:
					add 1 to {_n}
					if {turret.team::%{_k}%} is "blue":
						add 1 to {_nb}
					if {turret.team::%{_k}%} is "red":
						add 1 to {_nr}
			set {_my} to "blue"
			if {turret.team.player::%uuid of player%} is set:
				set {_my} to {turret.team.player::%uuid of player%}
			send "&b내 팀: &f%{_my}%" to player
			send "&b내 포탑: &f%{_n}%&7개 &9(블루 %{_nb}%) &c(레드 %{_nr}%)" to player
			stop

		if {_sub} is "제거":
			delete {_near}
			set {_best} to 999
			loop {turret.list::*}:
				if loop-value is set:
					set {_d} to distance between player and loop-value
					if {_d} <= 8:
						if {_d} < {_best}:
							set {_near} to loop-value
							set {_best} to {_d}
			if {_near} is not set:
				send "&c근처 8칸 안에 포탑이 없습니다." to player
				stop
			set {_k} to "%uuid of {_near}%"
			remove {_near} from {turret.list::*}
			delete {turret.hp::%{_k}%}
			delete {turret.maxhp::%{_k}%}
			delete {turret.team::%{_k}%}
			delete {turret.owner::%{_k}%}
			delete {turret.aggro::%{_k}%}
			delete {turret.aggro.until::%{_k}%}
			delete {turret.nextshot::%{_k}%}
			delete {turret.alive::%{_k}%}
			kill {_near}
			send "&a근처 포탑을 제거했습니다." to player
			stop

		if {_sub} is "소환":
			set {_team} to "blue"
			if {turret.team.player::%uuid of player%} is set:
				set {_team} to {turret.team.player::%uuid of player%}
			if arg-2 is set:
				set {_team} to arg-2

			if {_team} is "blue":
				set {turret.team.player::%uuid of player%} to "blue"
				set {_loc} to location of player
				spawn armor stand at {_loc}
				set {_stand} to last spawned entity
				set {_k} to "%uuid of {_stand}%"
				set helmet of {_stand} to light blue wool
				set chestplate of {_stand} to iron chestplate
				set leggings of {_stand} to iron leggings
				set boots of {_stand} to iron boots
				set {turret.hp::%{_k}%} to 300
				set {turret.maxhp::%{_k}%} to 300
				set {turret.team::%{_k}%} to "blue"
				set {turret.owner::%{_k}%} to "%uuid of player%"
				set {turret.alive::%{_k}%} to true
				set name of {_stand} to "&9&l블루 포탑 &8[&a||||||||||&8] &f300&7/&7300"
				add {_stand} to {turret.list::*}
				send "&9BLUE 포탑을 소환했습니다. &7(사거리 12)" to player
				play sound "block.anvil.place" with volume 0.8 and pitch 1.2 at player
				stop

			if {_team} is "red":
				set {turret.team.player::%uuid of player%} to "red"
				set {_loc} to location of player
				spawn armor stand at {_loc}
				set {_stand} to last spawned entity
				set {_k} to "%uuid of {_stand}%"
				set helmet of {_stand} to red wool
				set chestplate of {_stand} to iron chestplate
				set leggings of {_stand} to iron leggings
				set boots of {_stand} to iron boots
				set {turret.hp::%{_k}%} to 300
				set {turret.maxhp::%{_k}%} to 300
				set {turret.team::%{_k}%} to "red"
				set {turret.owner::%{_k}%} to "%uuid of player%"
				set {turret.alive::%{_k}%} to true
				set name of {_stand} to "&c&l레드 포탑 &8[&a||||||||||&8] &f300&7/&7300"
				add {_stand} to {turret.list::*}
				send "&cRED 포탑을 소환했습니다. &7(사거리 12)" to player
				play sound "block.anvil.place" with volume 0.8 and pitch 1.2 at player
				stop

			send "&c팀은 blue 또는 red 만 가능합니다." to player
			stop

		send "&c알 수 없는 하위명령입니다. /포탑" to player

# ---------- 0.5초마다 공격 ----------
every 10 ticks:
	loop {turret.list::*}:
		set {_t} to loop-value
		if {_t} is set:
			set {_k} to "%uuid of {_t}%"
			if {turret.alive::%{_k}%} is set:
				set {_canShoot} to true
				if {turret.nextshot::%{_k}%} is set:
					if difference between {turret.nextshot::%{_k}%} and now < 1 second:
						set {_canShoot} to false
				if {_canShoot} is true:
					set {_team} to {turret.team::%{_k}%}
					delete {_target}

					# 어그로 (같은 팀이면 무시)
					if {turret.aggro::%{_k}%} is set:
						set {_aggro} to {turret.aggro::%{_k}%}
						if {_aggro} is set:
							set {_ok} to false
							# 플레이어 어그로
							if {_aggro} is a player:
								set {_ateam} to "blue"
								if {turret.team.player::%uuid of {_aggro}%} is set:
									set {_ateam} to {turret.team.player::%uuid of {_aggro}%}
								if {_ateam} is not {_team}:
									set {_ahp} to health of {_aggro}
									if {_ahp} is set:
										if {_ahp} > 0:
											set {_ad} to distance between {_t} and {_aggro}
											if {_ad} <= 12:
												set {_ok} to true
							# 적 포탑 어그로
							if {_aggro} is an armor stand:
								set {_ak} to "%uuid of {_aggro}%"
								if {turret.hp::%{_ak}%} is set:
									if {turret.team::%{_ak}%} is not {_team}:
										if {turret.hp::%{_ak}%} > 0:
											set {_ad} to distance between {_t} and {_aggro}
											if {_ad} <= 12:
												set {_ok} to true
							# 일반 몹
							if {_aggro} is not a player:
								if {_aggro} is not an armor stand:
									set {_ahp} to health of {_aggro}
									if {_ahp} is set:
										if {_ahp} > 0:
											set {_ad} to distance between {_t} and {_aggro}
											if {_ad} <= 12:
												set {_ok} to true
							if {_ok} is true:
								if {turret.aggro.until::%{_k}%} is set:
									if difference between {turret.aggro.until::%{_k}%} and now < 6 seconds:
										set {_target} to {_aggro}
						if {_target} is not set:
							delete {turret.aggro::%{_k}%}
							delete {turret.aggro.until::%{_k}%}

					# 가장 가까운 적 (적 팀 포탑 포함)
					if {_target} is not set:
						set {_bestDist} to 9999
						loop all entities in radius 12 around {_t}:
							set {_e} to loop-entity
							if {_e} is not {_t}:
								set {_valid} to false
								if {_e} is a player:
									set {_eteam} to "blue"
									if {turret.team.player::%uuid of {_e}%} is set:
										set {_eteam} to {turret.team.player::%uuid of {_e}%}
									if {_eteam} is not {_team}:
										set {_ehp} to health of {_e}
										if {_ehp} is set:
											if {_ehp} > 0:
												set {_valid} to true
								if {_e} is an armor stand:
									set {_ek} to "%uuid of {_e}%"
									if {turret.hp::%{_ek}%} is set:
										if {turret.team::%{_ek}%} is not {_team}:
											if {turret.hp::%{_ek}%} > 0:
												set {_valid} to true
								if {_e} is not a player:
									if {_e} is not an armor stand:
										set {_ehp} to health of {_e}
										if {_ehp} is set:
											if {_ehp} > 0:
												set {_valid} to true
								if {_valid} is true:
									set {_d} to distance between {_t} and {_e}
									if {_d} < {_bestDist}:
										set {_target} to {_e}
										set {_bestDist} to {_d}

					if {_target} is set:
						set {_from} to location of {_t}
						add 1.6 to y-coordinate of {_from}
						set {_to} to location of {_target}
						add 1 to y-coordinate of {_to}
						set {_i} to 0
						loop 12 times:
							add 1 to {_i}
							set {_r} to {_i} / 12
							set {_p} to {_from}
							set x-coordinate of {_p} to (x-coordinate of {_from}) + ((x-coordinate of {_to} - x-coordinate of {_from}) * {_r})
							set y-coordinate of {_p} to (y-coordinate of {_from}) + ((y-coordinate of {_to} - y-coordinate of {_from}) * {_r})
							set z-coordinate of {_p} to (z-coordinate of {_from}) + ((z-coordinate of {_to} - z-coordinate of {_from}) * {_r})
							# 팀별 레이저 색
							if {_team} is "blue":
								play particle happy villager at {_p}
							if {_team} is "red":
								play particle flame at {_p}
						play sound "entity.guardian.attack" with volume 0.55 and pitch 1.4 at {_t}
						# 적 포탑이면 커스텀 체력으로
						if {_target} is an armor stand:
							set {_tk} to "%uuid of {_target}%"
							if {turret.hp::%{_tk}%} is set:
								set {_thp} to {turret.hp::%{_tk}%}
								remove 7 from {_thp}
								if {_thp} < 0:
									set {_thp} to 0
								set {turret.hp::%{_tk}%} to {_thp}
								set {turret.aggro::%{_tk}%} to {_t}
								set {turret.aggro.until::%{_tk}%} to now
								if {_thp} <= 0:
									set {_tloc} to location of {_target}
									play sound "entity.generic.explode" with volume 1 and pitch 0.8 at {_tloc}
									send "&e적 포탑이 파괴되었습니다!" to all players in radius 20 around {_target}
									remove {_target} from {turret.list::*}
									delete {turret.hp::%{_tk}%}
									delete {turret.maxhp::%{_tk}%}
									delete {turret.team::%{_tk}%}
									delete {turret.owner::%{_tk}%}
									delete {turret.aggro::%{_tk}%}
									delete {turret.aggro.until::%{_tk}%}
									delete {turret.nextshot::%{_tk}%}
									delete {turret.alive::%{_tk}%}
									kill {_target}
							else:
								damage {_target} by 7
						else:
							damage {_target} by 7
						set {turret.aggro::%{_k}%} to {_target}
						set {turret.aggro.until::%{_k}%} to now
						set {turret.nextshot::%{_k}%} to now

# ---------- 팀 표시 파티클 + 체력바 ----------
every 20 ticks:
	# 팀 오라
	loop {turret.list::*}:
		set {_t} to loop-value
		if {_t} is set:
			set {_k} to "%uuid of {_t}%"
			if {turret.alive::%{_k}%} is set:
				set {_loc} to location of {_t}
				add 2.2 to y-coordinate of {_loc}
				if {turret.team::%{_k}%} is "blue":
					play particle happy villager at {_loc}
				if {turret.team::%{_k}%} is "red":
					play particle flame at {_loc}

	# 근처 플레이어 HUD
	loop all players:
		set {_p} to loop-player
		delete {_near}
		set {_best} to 999
		loop {turret.list::*}:
			set {_t} to loop-value
			if {_t} is set:
				set {_d} to distance between {_p} and {_t}
				if {_d} <= 16:
					if {_d} < {_best}:
						set {_near} to {_t}
						set {_best} to {_d}
		if {_near} is set:
			set {_k} to "%uuid of {_near}%"
			if {turret.hp::%{_k}%} is set:
				set {_hp} to {turret.hp::%{_k}%}
				set {_max} to {turret.maxhp::%{_k}%}
				set {_team} to {turret.team::%{_k}%}
				set {_color} to "&9"
				set {_label} to "블루 포탑"
				if {_team} is "red":
					set {_color} to "&c"
					set {_label} to "레드 포탑"
				set {_filled} to round(({_hp} / {_max}) * 10)
				if {_filled} > 10:
					set {_filled} to 10
				if {_filled} < 0:
					set {_filled} to 0
				set {_barColor} to "&a"
				if {_filled} <= 6:
					set {_barColor} to "&e"
				if {_filled} <= 3:
					set {_barColor} to "&c"
				set {_bar} to "&8["
				set {_n} to 0
				loop 10 times:
					add 1 to {_n}
					if {_n} <= {_filled}:
						set {_bar} to "%{_bar}%%{_barColor}%|"
					else:
						set {_bar} to "%{_bar}%&7|"
				set {_bar} to "%{_bar}%&8]"
				set name of {_near} to "%{_color}%&l%{_label}% %{_bar}% &f%{_hp}%&7/&7%{_max}%"
				send action bar "%{_color}%&l%{_label}% %{_bar}% &f%{_hp}%&7/&7%{_max}%" to {_p}

# ---------- 포탑 피격 / 아군 보호 ----------
on damage:
	if victim is not set:
		stop

	if victim is an armor stand:
		set {_k} to "%uuid of victim%"
		if {turret.hp::%{_k}%} is set:
			cancel event
			set {_team} to {turret.team::%{_k}%}
			# 같은 팀 플레이어 공격 무시
			if attacker is a player:
				set {_ateam} to "blue"
				if {turret.team.player::%uuid of attacker%} is set:
					set {_ateam} to {turret.team.player::%uuid of attacker%}
				if {_ateam} is {_team}:
					send action bar "&7아군 포탑은 공격할 수 없습니다." to attacker
					stop
			# 같은 팀 포탑끼리 무시
			if attacker is an armor stand:
				set {_ak} to "%uuid of attacker%"
				if {turret.team::%{_ak}%} is set:
					if {turret.team::%{_ak}%} is {_team}:
						stop

			set {_hp} to {turret.hp::%{_k}%}
			remove damage from {_hp}
			if {_hp} < 0:
				set {_hp} to 0
			set {turret.hp::%{_k}%} to {_hp}
			if attacker is set:
				set {turret.aggro::%{_k}%} to attacker
				set {turret.aggro.until::%{_k}%} to now
			set {_max} to {turret.maxhp::%{_k}%}
			set {_color} to "&9"
			set {_label} to "블루 포탑"
			if {_team} is "red":
				set {_color} to "&c"
				set {_label} to "레드 포탑"
			set {_filled} to round(({_hp} / {_max}) * 10)
			if {_filled} > 10:
				set {_filled} to 10
			if {_filled} < 0:
				set {_filled} to 0
			set {_barColor} to "&a"
			if {_filled} <= 6:
				set {_barColor} to "&e"
			if {_filled} <= 3:
				set {_barColor} to "&c"
			set {_bar} to "&8["
			set {_n} to 0
			loop 10 times:
				add 1 to {_n}
				if {_n} <= {_filled}:
					set {_bar} to "%{_bar}%%{_barColor}%|"
				else:
					set {_bar} to "%{_bar}%&7|"
			set {_bar} to "%{_bar}%&8]"
			set name of victim to "%{_color}%&l%{_label}% %{_bar}% &f%{_hp}%&7/&7%{_max}%"
			loop all players in radius 16 around victim:
				send action bar "%{_color}%&l%{_label}% %{_bar}% &f%{_hp}%&7/&7%{_max}%" to loop-player
			if {_hp} <= 0:
				set {_loc} to location of victim
				play sound "entity.generic.explode" with volume 1 and pitch 0.8 at {_loc}
				loop 15 times:
					if {_team} is "blue":
						play particle happy villager at {_loc}
					if {_team} is "red":
						play particle flame at {_loc}
				send "%{_color}%&l%{_label}%&r &7이(가) 파괴되었습니다!" to all players in radius 20 around victim
				remove victim from {turret.list::*}
				delete {turret.hp::%{_k}%}
				delete {turret.maxhp::%{_k}%}
				delete {turret.team::%{_k}%}
				delete {turret.owner::%{_k}%}
				delete {turret.aggro::%{_k}%}
				delete {turret.aggro.until::%{_k}%}
				delete {turret.nextshot::%{_k}%}
				delete {turret.alive::%{_k}%}
				kill victim
			stop

	# 아군이 맞으면 근처 아군 포탑 어그로 (가해자가 적 팀일 때만)
	if victim is a player:
		if attacker is set:
			set {_vteam} to "blue"
			if {turret.team.player::%uuid of victim%} is set:
				set {_vteam} to {turret.team.player::%uuid of victim%}
			set {_enemy} to true
			if attacker is a player:
				set {_ateam} to "blue"
				if {turret.team.player::%uuid of attacker%} is set:
					set {_ateam} to {turret.team.player::%uuid of attacker%}
				if {_ateam} is {_vteam}:
					set {_enemy} to false
			if {_enemy} is true:
				loop all armor stands in radius 12 around victim:
					set {_k} to "%uuid of loop-armor stand%"
					if {turret.hp::%{_k}%} is set:
						if {turret.team::%{_k}%} is {_vteam}:
							set {turret.aggro::%{_k}%} to attacker
							set {turret.aggro.until::%{_k}%} to now
