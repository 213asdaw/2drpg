# ============================================================
# 롤 스타일 포탑 (구버전 Skript 호환 / 함수 없음)
# plugins/Skript/scripts/포탑.sk
#
# 명령어:
#   /포탑 소환 [blue|red]
#   /포탑 제거
#   /포탑 목록
#   /포탑 팀 <blue|red>
#
# 설정: 사거리12 / 데미지7 / 쿨1초 / 어그로6초 / 체력300
# ============================================================

command /포탑 [<text>] [<text>]:
	trigger:
		set {_sub} to arg-1
		if {_sub} is not set:
			send "&e/포탑 소환 [blue|red]" to player
			send "&e/포탑 제거" to player
			send "&e/포탑 목록" to player
			send "&e/포탑 팀 <blue|red>" to player
			stop

		if {_sub} is "팀":
			if arg-2 is not set:
				send "&c사용법: /포탑 팀 <blue|red>" to player
				stop
			set {_team} to arg-2
			if {_team} is "blue":
				set {turret.team.player::%uuid of player%} to "blue"
				send "&a팀을 &fblue&a 로 설정했습니다." to player
				stop
			if {_team} is "red":
				set {turret.team.player::%uuid of player%} to "red"
				send "&a팀을 &fred&a 로 설정했습니다." to player
				stop
			send "&c팀은 blue 또는 red 만 가능합니다." to player
			stop

		if {_sub} is "목록":
			set {_n} to 0
			set {_u} to "%uuid of player%"
			loop {turret.list::*}:
				set {_k} to "%uuid of loop-value%"
				if {turret.owner::%{_k}%} is {_u}:
					add 1 to {_n}
			send "&b내 포탑: &f%{_n}%&7개" to player
			stop

		if {_sub} is "제거":
			delete {_near}
			set {_best} to 999
			loop {turret.list::*}:
				if loop-value is set:
					set {_d} to distance between player and loop-value
					if {_d} <= 8:
						if {_d} < {_best}:
							set {_near} to loop-value
							set {_best} to {_d}
			if {_near} is not set:
				send "&c근처 8칸 안에 포탑이 없습니다." to player
				stop
			set {_k} to "%uuid of {_near}%"
			remove {_near} from {turret.list::*}
			delete {turret.hp::%{_k}%}
			delete {turret.maxhp::%{_k}%}
			delete {turret.team::%{_k}%}
			delete {turret.owner::%{_k}%}
			delete {turret.aggro::%{_k}%}
			delete {turret.aggro.until::%{_k}%}
			delete {turret.nextshot::%{_k}%}
			delete {turret.alive::%{_k}%}
			kill {_near}
			send "&a근처 포탑을 제거했습니다." to player
			stop

		if {_sub} is "소환":
			set {_team} to "blue"
			if {turret.team.player::%uuid of player%} is set:
				set {_team} to {turret.team.player::%uuid of player%}
			if arg-2 is set:
				set {_team} to arg-2
			if {_team} is "blue":
				set {turret.team.player::%uuid of player%} to {_team}
				set {_loc} to location of player
				spawn armor stand at {_loc}
				set {_stand} to last spawned armor stand
				set {_k} to "%uuid of {_stand}%"
				set helmet of {_stand} to iron block
				set chestplate of {_stand} to iron chestplate
				set {turret.hp::%{_k}%} to 300
				set {turret.maxhp::%{_k}%} to 300
				set {turret.team::%{_k}%} to {_team}
				set {turret.owner::%{_k}%} to "%uuid of player%"
				set {turret.alive::%{_k}%} to true
				set name of {_stand} to "&9&l포탑 &7[300&7/&f300&7]"
				add {_stand} to {turret.list::*}
				send "&ablue 팀 포탑을 소환했습니다. &7(사거리 12)" to player
				play sound "block.anvil.place" with volume 0.8 and pitch 1.2 at player
				stop
			if {_team} is "red":
				set {turret.team.player::%uuid of player%} to {_team}
				set {_loc} to location of player
				spawn armor stand at {_loc}
				set {_stand} to last spawned armor stand
				set {_k} to "%uuid of {_stand}%"
				set helmet of {_stand} to iron block
				set chestplate of {_stand} to iron chestplate
				set {turret.hp::%{_k}%} to 300
				set {turret.maxhp::%{_k}%} to 300
				set {turret.team::%{_k}%} to {_team}
				set {turret.owner::%{_k}%} to "%uuid of player%"
				set {turret.alive::%{_k}%} to true
				set name of {_stand} to "&c&l포탑 &7[300&7/&f300&7]"
				add {_stand} to {turret.list::*}
				send "&ared 팀 포탑을 소환했습니다. &7(사거리 12)" to player
				play sound "block.anvil.place" with volume 0.8 and pitch 1.2 at player
				stop
			send "&c팀은 blue 또는 red 만 가능합니다." to player
			stop

		send "&c알 수 없는 하위명령입니다. /포탑" to player

# ---------- 0.5초마다 공격 ----------
every 10 ticks:
	loop {turret.list::*}:
		set {_t} to loop-value
		if {_t} is set:
			set {_k} to "%uuid of {_t}%"
			if {turret.alive::%{_k}%} is set:
				set {_canShoot} to true
				if {turret.nextshot::%{_k}%} is set:
					if difference between {turret.nextshot::%{_k}%} and now < 1 second:
						set {_canShoot} to false
				if {_canShoot} is true:
					set {_team} to {turret.team::%{_k}%}
					delete {_target}

					# 어그로 우선
					if {turret.aggro::%{_k}%} is set:
						set {_aggro} to {turret.aggro::%{_k}%}
						if {_aggro} is set:
							if {_aggro} is not an armor stand:
								set {_ahp} to health of {_aggro}
								if {_ahp} is set:
									if {_ahp} > 0:
										set {_ad} to distance between {_t} and {_aggro}
										if {_ad} <= 12:
											set {_ok} to true
											if {_aggro} is a player:
												set {_ateam} to "blue"
												if {turret.team.player::%uuid of {_aggro}%} is set:
													set {_ateam} to {turret.team.player::%uuid of {_aggro}%}
												if {_ateam} is {_team}:
													set {_ok} to false
											if {_ok} is true:
												if {turret.aggro.until::%{_k}%} is set:
													if difference between {turret.aggro.until::%{_k}%} and now < 6 seconds:
														set {_target} to {_aggro}
						if {_target} is not set:
							delete {turret.aggro::%{_k}%}
							delete {turret.aggro.until::%{_k}%}

					# 가장 가까운 적
					if {_target} is not set:
						set {_bestDist} to 9999
						loop all entities in radius 12 around {_t}:
							set {_e} to loop-entity
							if {_e} is not {_t}:
								if {_e} is not an armor stand:
									set {_ehp} to health of {_e}
									if {_ehp} is set:
										if {_ehp} > 0:
											set {_valid} to true
											if {_e} is a player:
												set {_eteam} to "blue"
												if {turret.team.player::%uuid of {_e}%} is set:
													set {_eteam} to {turret.team.player::%uuid of {_e}%}
												if {_eteam} is {_team}:
													set {_valid} to false
											if {_valid} is true:
												set {_d} to distance between {_t} and {_e}
												if {_d} < {_bestDist}:
													set {_target} to {_e}
													set {_bestDist} to {_d}

					if {_target} is set:
						set {_from} to location of {_t}
						add 1.6 to y-coordinate of {_from}
						set {_to} to location of {_target}
						add 1 to y-coordinate of {_to}
						set {_i} to 0
						loop 12 times:
							add 1 to {_i}
							set {_r} to {_i} / 12
							set {_p} to {_from}
							set x-coordinate of {_p} to (x-coordinate of {_from}) + ((x-coordinate of {_to} - x-coordinate of {_from}) * {_r})
							set y-coordinate of {_p} to (y-coordinate of {_from}) + ((y-coordinate of {_to} - y-coordinate of {_from}) * {_r})
							set z-coordinate of {_p} to (z-coordinate of {_from}) + ((z-coordinate of {_to} - z-coordinate of {_from}) * {_r})
							play crit at {_p}
						play sound "entity.guardian.attack" with volume 0.55 and pitch 1.4 at {_t}
						damage {_target} by 7
						set {turret.aggro::%{_k}%} to {_target}
						set {turret.aggro.until::%{_k}%} to now
						set {turret.nextshot::%{_k}%} to now

# ---------- 포탑 피격 / 아군 보호 어그로 ----------
on damage:
	if victim is not set:
		stop

	if victim is an armor stand:
		set {_k} to "%uuid of victim%"
		if {turret.hp::%{_k}%} is set:
			cancel event
			set {_hp} to {turret.hp::%{_k}%}
			remove damage from {_hp}
			set {turret.hp::%{_k}%} to {_hp}
			if attacker is set:
				if attacker is not an armor stand:
					set {turret.aggro::%{_k}%} to attacker
					set {turret.aggro.until::%{_k}%} to now
			set {_max} to {turret.maxhp::%{_k}%}
			set {_team} to {turret.team::%{_k}%}
			set {_color} to "&9"
			if {_team} is "red":
				set {_color} to "&c"
			set name of victim to "%{_color}%&l포탑 &7[%{_hp}%&7/&f%{_max}%&7]"
			if {_hp} <= 0:
				set {_loc} to location of victim
				play sound "entity.generic.explode" with volume 1 and pitch 0.8 at {_loc}
				loop 15 times:
					play crit at {_loc}
				send "&c포탑이 파괴되었습니다!" to all players in radius 20 around victim
				remove victim from {turret.list::*}
				delete {turret.hp::%{_k}%}
				delete {turret.maxhp::%{_k}%}
				delete {turret.team::%{_k}%}
				delete {turret.owner::%{_k}%}
				delete {turret.aggro::%{_k}%}
				delete {turret.aggro.until::%{_k}%}
				delete {turret.nextshot::%{_k}%}
				delete {turret.alive::%{_k}%}
				kill victim
			stop

	if victim is a player:
		if attacker is set:
			set {_vteam} to "blue"
			if {turret.team.player::%uuid of victim%} is set:
				set {_vteam} to {turret.team.player::%uuid of victim%}
			loop all armor stands in radius 12 around victim:
				set {_k} to "%uuid of loop-armor stand%"
				if {turret.hp::%{_k}%} is set:
					if {turret.team::%{_k}%} is {_vteam}:
						if attacker is not an armor stand:
							set {turret.aggro::%{_k}%} to attacker
							set {turret.aggro.until::%{_k}%} to now
