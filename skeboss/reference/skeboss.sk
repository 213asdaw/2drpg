# ============================================================
# SkeBoss 통합 Skript — 보스 스탯 + RPG 데미지
# plugins/Skript/scripts/skeboss.sk
#
# 무기 우클릭은 SkeBoss 플러그인이 처리 (OP 불필요)
# 무기 지급: /skeboss weapon artificial-arm
# ============================================================

options:
	boss-name: 인조인간
	bdef: 240
	batk: 80
	bexp: 500
	bmelee: 10

function initSkeBossStats(boss: entity):
	set {_u} to uuid of {_boss}
	set {방어력::%{_u}%} to {@bdef}
	set {공격력::%{_u}%} to {@batk}
	set {방어력::%{_boss}%} to {@bdef}
	set {공격력::%{_boss}%} to {@batk}
	set {boss.init::%{_u}%} to true

function clearSkeBossStats(boss: entity):
	set {_u} to uuid of {_boss}
	delete {방어력::%{_boss}%}
	delete {공격력::%{_boss}%}
	delete {방어력::%{_u}%}
	delete {공격력::%{_u}%}
	delete {boss.init::%{_u}%}

function getDefense(e: entity) :: number:
	if {방어력::%{_e}%} is set:
		return {방어력::%{_e}%}
	set {_u} to uuid of {_e}
	if {방어력::%{_u}%} is set:
		return {방어력::%{_u}%}
	return 0

function getAttack(e: entity) :: number:
	if {공격력::%{_e}%} is set:
		return {공격력::%{_e}%}
	set {_u} to uuid of {_e}
	if {공격력::%{_u}%} is set:
		return {공격력::%{_u}%}
	return 0

# ---------- 보스 스탯 ----------
on spawn of zombie:
	wait 5 ticks
	if uncolored name of event-entity does not contain "{@boss-name}":
		stop
	set {_u} to uuid of event-entity
	if {boss.init::%{_u}%} is not set:
		initSkeBossStats(event-entity)

every 15 seconds:
	loop all zombies:
		if uncolored name of loop-zombie does not contain "{@boss-name}":
			continue
		set {_u} to uuid of loop-zombie
		if {boss.init::%{_u}%} is not set:
			initSkeBossStats(loop-zombie)

# ---------- RPG 데미지 ----------
on damage:
	if attacker is not set:
		stop

	set {_isBoss} to false
	if attacker is a zombie:
		if uncolored name of attacker contains "{@boss-name}":
			set {_isBoss} to true

	if {_isBoss} is true:
		set {공격::%attacker%} to damage
		set {_atk} to getAttack(attacker)
		if damage <= {@bmelee}:
			if {_atk} > 0:
				add {_atk} to {공격::%attacker%}
	else:
		set {공격::%attacker%} to damage
		set {_atk} to getAttack(attacker)
		if {_atk} > 0:
			add {_atk} to {공격::%attacker%}

	if victim is set:
		set {막는량::%victim%} to 0
		set {_def} to getDefense(victim)
		if {_def} > 0:
			set {막는량::%victim%} to {_def} / 4
		if {막는량::%victim%} > 90:
			set {막는량::%victim%} to 90
		remove {공격::%attacker%} * {막는량::%victim%} / 100 from {공격::%attacker%}

	if attacker is a player:
		if scoreboard tags of attacker does not contain "using_skill":
			set damage to {공격::%attacker%}
	else:
		set damage to {공격::%attacker%}

on death of zombie:
	if uncolored name of victim does not contain "{@boss-name}":
		stop
	clearSkeBossStats(victim)
	wait 1 tick
	set {_loc} to location of victim
	drop 3 diamond named "&b인조인간 파편" at {_loc}
	drop 1 netherite scrap at {_loc}
	chance of 25%:
		drop 1 emerald block at {_loc}
	if attacker is a player:
		give {@bexp} xp to attacker
	else:
		drop {@bexp} experience at {_loc}
